# Auto detect text files and perform LF normalization
* text=auto

# Source code and text files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Scripts: Unix shell scripts must use LF
*.sh text eol=lf
mvnw text eol=lf

# Scripts: Windows scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
